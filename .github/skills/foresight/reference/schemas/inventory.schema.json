{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "foresight inventory.json \u2014 what the product does",
  "type": "object",
  "required": [
    "features"
  ],
  "properties": {
    "generated_at_iso": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "test_run_command": {
      "type": "string"
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "use_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "platform": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "user_facing": {
                  "type": "boolean"
                },
                "ui_elements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "user_story": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "ui_elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "behavior": {
                  "type": "string"
                },
                "use_case": {
                  "type": "string"
                },
                "user_story": {
                  "type": "string"
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "visual": {
                  "type": "object",
                  "properties": {
                    "screenshot": {
                      "type": "string"
                    },
                    "region": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "number"
                      }
                    },
                    "label": {
                      "type": "string"
                    },
                    "discovered_by": {
                      "type": "string",
                      "enum": [
                        "visual",
                        "code",
                        "exploration"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
