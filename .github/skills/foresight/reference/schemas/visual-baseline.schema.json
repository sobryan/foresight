{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "foresight visual/baseline.json \u2014 reference screenshots",
  "type": "object",
  "required": [
    "recorded_at_iso",
    "project",
    "run",
    "images"
  ],
  "properties": {
    "recorded_at_iso": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "run": {
      "type": "string"
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "file",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  }
}
