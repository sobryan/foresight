{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "foresight reorg.json \u2014 proposed priority/feature/serial",
  "type": "object",
  "required": [
    "generated_at_iso",
    "projects",
    "n_entries",
    "n_with_changes",
    "feature_buckets",
    "reorg_needed",
    "reorg_reasons",
    "proposals"
  ],
  "properties": {
    "generated_at_iso": {
      "type": "string"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "n_entries": {
      "type": "integer"
    },
    "n_with_changes": {
      "type": "integer"
    },
    "feature_buckets": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "reorg_needed": {
      "type": "boolean"
    },
    "reorg_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "project",
          "current",
          "suggested",
          "changes",
          "protected"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "current": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "feature": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serial": {
                "type": "boolean"
              }
            }
          },
          "suggested": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "feature": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serial": {
                "type": "boolean"
              }
            }
          },
          "changes": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "feature": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serial": {
                "type": "boolean"
              }
            }
          },
          "protected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "override": {
            "type": "object",
            "properties": {
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "feature": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "serial": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
